# --- Providers ---
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key
LLM_PROVIDER=gemini          # "fake" runs the full pipeline offline (tests, CI, eval)
LLM_MODEL=gemini-flash-lite-latest
EMBEDDING_MODEL=gemini-embedding-001
# Model names are retired over time (gemini-2.0-flash and text-embedding-004 already have been).
# If calls fail with 404 NOT_FOUND, pick a current model. After changing EMBEDDING_MODEL,
# re-index your documents: vectors from different embedding models are not comparable.

# --- App ---
ENVIRONMENT=local            # local | staging | production
LOG_LEVEL=INFO
API_KEY=                     # set in production; clients send it as X-API-Key
CORS_ORIGINS=*

# --- Storage ---
CHROMA_PATH=./data/chroma
DATABASE_URL=sqlite:///./data/copilot.db

# --- Retrieval tuning ---
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=6
MMR_LAMBDA=0.65

# --- Vercel / serverless ---
# VECTOR_STORE=sql           # default on Vercel; "chroma" needs a persistent disk
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require   # Neon / Supabase / Vercel Postgres
