# --- Providers ---
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key
LLM_PROVIDER=gemini          # "fake" runs the full pipeline offline (tests, CI, eval)
LLM_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-004

# --- App ---
ENVIRONMENT=local            # local | staging | production
LOG_LEVEL=INFO
API_KEY=                     # set in production; clients send it as X-API-Key
CORS_ORIGINS=*

# --- Storage ---
CHROMA_PATH=./data/chroma
DATABASE_URL=sqlite:///./data/copilot.db

# --- Retrieval tuning ---
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=6
MMR_LAMBDA=0.65
